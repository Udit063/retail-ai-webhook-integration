{
  "info": {
    "name": "Retail AI Services – Transaction Webhook Integration (Final)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8765"},
    {"key": "receiverUrl", "value": "http://127.0.0.1:8766"},
    {"key": "signature", "value": "sha256=GENERATE_VIA_SEND_EVENT_PY"}
  ],
  "item": [
    {
      "name": "T00 – Listener health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": []}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('listener health 200', () => pm.response.to.have.status(200));",
        "pm.test('service name', () => pm.expect(pm.response.json().service).to.eql('transaction-listener'));"
      ]}}]
    },
    {
      "name": "T00 – Receiver health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{receiverUrl}}/health", "host": ["{{receiverUrl}}"], "path": []}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('receiver health 200', () => pm.response.to.have.status(200));",
        "pm.test('service name', () => pm.expect(pm.response.json().service).to.eql('local-slack-receiver'));"
      ]}}]
    },
    {
      "name": "T00 – Receiver deliveries",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{receiverUrl}}/deliveries", "host": ["{{receiverUrl}}"], "path": []}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('deliveries array', () => pm.expect(pm.response.json().deliveries).to.be.an('array'));"
      ]}}]
    },
    {
      "name": "T01 – Valid success event (EVT-0001)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0001\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"order_id\": \"ORD-0001\",\n    \"customer_ref\": \"CUST-002\",\n    \"amount_minor\": 93600,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('notified', () => pm.expect(pm.response.json().status).to.eql('notified'));",
        "pm.test('correct txn', () => pm.expect(pm.response.json().transaction_id).to.eql('TXN-0001'));"
      ]}}]
    },
    {
      "name": "T02 – Duplicate event (EVT-0001 repeat)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0001\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"order_id\": \"ORD-0001\",\n    \"customer_ref\": \"CUST-002\",\n    \"amount_minor\": 93600,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('duplicate detected', () => pm.expect(pm.response.json().status).to.eql('duplicate'));"
      ]}}]
    },
    {
      "name": "T04 – Failed transaction (EVT-0002)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0002\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0004\",\n    \"order_id\": \"ORD-0004\",\n    \"customer_ref\": \"CUST-005\",\n    \"amount_minor\": 134700,\n    \"currency\": \"INR\",\n    \"status\": \"failed\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('no notification', () => pm.expect(pm.response.json().notify).to.eql(false));"
      ]}}]
    },
    {
      "name": "T05 – Pending transaction (EVT-0003)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0003\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0005\",\n    \"order_id\": \"ORD-0005\",\n    \"customer_ref\": \"CUST-006\",\n    \"amount_minor\": 148400,\n    \"currency\": \"INR\",\n    \"status\": \"pending\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('no notification', () => pm.expect(pm.response.json().notify).to.eql(false));"
      ]}}]
    },
    {
      "name": "T06 – Missing signature",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0001\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"order_id\": \"ORD-0001\",\n    \"customer_ref\": \"CUST-002\",\n    \"amount_minor\": 93600,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 401', () => pm.response.to.have.status(401));",
        "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('invalid signature'));"
      ]}}]
    },
    {
      "name": "T07 – Wrong signature",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "sha256=00000000deadbeefcafebabe11111111"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0001\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"order_id\": \"ORD-0001\",\n    \"customer_ref\": \"CUST-002\",\n    \"amount_minor\": 93600,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 401', () => pm.response.to.have.status(401));"
      ]}}]
    },
    {
      "name": "T08 – Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{not valid json at all{{",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 400', () => pm.response.to.have.status(400));"
      ]}}]
    },
    {
      "name": "T09 – Missing required fields (bad schema)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0007\",\n  \"event_type\": \"transaction.status_changed\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 400', () => pm.response.to.have.status(400));",
        "pm.test('mentions missing', () => pm.expect(pm.response.json().error).to.include('missing'));"
      ]}}]
    },
    {
      "name": "T10 – Unknown transaction (TXN-9999)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0008\",\n  \"event_type\": \"transaction.status_changed\",\n  \"data\": {\n    \"transaction_id\": \"TXN-9999\",\n    \"order_id\": \"ORD-9999\",\n    \"customer_ref\": \"CUST-001\",\n    \"amount_minor\": 11100,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  },\n  \"created_at\": \"2026-11-23T10:30:00Z\"\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 404', () => pm.response.to.have.status(404));",
        "pm.test('transaction not found', () => pm.expect(pm.response.json().error).to.eql('transaction not found'));"
      ]}}]
    },
    {
      "name": "T11 – Data mismatch against DB",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-MISMATCH-01\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0001\",\n    \"order_id\": \"ORD-WRONG\",\n    \"customer_ref\": \"CUST-002\",\n    \"amount_minor\": 93600,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('rejected 409', () => pm.response.to.have.status(409));",
        "pm.test('mismatch field', () => pm.expect(pm.response.json().field).to.eql('order_id'));"
      ]}}]
    },
    {
      "name": "T14 – Key masking check (success event EVT-0004)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Event-Signature", "value": "{{signature}}"}
        ],
        "url": {"raw": "{{baseUrl}}/events/transaction", "host": ["{{baseUrl}}"], "path": []},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"EVT-0004\",\n  \"event_type\": \"transaction.status_changed\",\n  \"created_at\": \"2026-11-23T10:30:00Z\",\n  \"data\": {\n    \"transaction_id\": \"TXN-0002\",\n    \"order_id\": \"ORD-0002\",\n    \"customer_ref\": \"CUST-003\",\n    \"amount_minor\": 107300,\n    \"currency\": \"INR\",\n    \"status\": \"success\"\n  }\n}",
          "options": {"raw": {"language": "json"}}
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('notified', () => pm.expect(pm.response.json().status).to.eql('notified'));"
      ]}}]
    },
    {
      "name": "T14 – Verify delivery has no customer_ref",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{receiverUrl}}/deliveries", "host": ["{{receiverUrl}}"], "path": []}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('deliveries exist', () => { const d = pm.response.json().deliveries; pm.expect(d.length).to.be.above(0); });",
        "pm.test('no customer_ref in payloads', () => { const raw = pm.response.text(); pm.expect(raw).to.not.include('CUST-'); });"
      ]}}]
    }
  ]
}
